[Body Rewrite]
http-response ^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=lite_advertising jdLiteAdvertisingVO SUCCEED
http-response ^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=lite_SmartPush pushData SUCCEED
http-response ^https?:\/\/api\.zhihu\.com\/search\/recommend_query\/v2\? "recommend_queries":\{.+\} "recommend_queries":{}
http-response-jq ^https?:\/\/api\.zhihu\.com\/search\/recommend_query\/v2\? 'del(.recommend_queries)'

[Map Local]
^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? data-type=text data="{\"code\":0,\"data\":{\"closeType\":\"close_win\",\"container\":[],\"showTime\":\"\"},\"message\":\"success\"}" status-code=200 header="content-type: application/json"

[Script]
# 旧版脚本多数已由当前新框架覆盖，本临时文件只保留少量公开 raw 示例，迁移脚本会继续筛选。
legacy_safe_qqnews = type=http-response,pattern=^https?:\/\/(news\.ssp\.qq\.com\/app|r\.inews\.qq\.com\/(get(QQNewsUnreadList|TagFeedList)|news_feed\/hot_module_list)),script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/qq-news.js,requires-body=1,timeout=60,script-update-interval=86400

[MITM]
hostname = %APPEND% adashx.ut.taobao.com,adx.alibaba.com,ad.alicdn.com,api.m.jd.com,api.zhihu.com,api.bilibili.com,news.ssp.qq.com,r.inews.qq.com
