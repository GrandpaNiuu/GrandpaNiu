#!name=GrandpaNiu YY语音 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/yyvoice-tool.sgmodule

[URL Rewrite]
^https://yuyin-api\.baizhanlive\.com/homepage/flashscreen/get\? - reject-dict
^https://yuyin-api\.baizhanlive\.com/homepage/homepage/banner\? - reject-dict
^https://web\.yy\.com/yyvoice_task_sys/bar\.html\? - reject
^https://yuyin-api\.baizhanlive\.com/search/search/hotword\? - reject-dict

[Body Rewrite]
http-response-jq ^https://yuyin-api\.baizhanlive\.com/postsquare/college/page/tabsV3\? '.data.tabList |= map(select(.code == "post" or .code == "teamup" or .code == "college" or .code == "aiSecretRoom"))'

[MITM]
hostname = %APPEND% yuyin-api.baizhanlive.com,web.yy.com
