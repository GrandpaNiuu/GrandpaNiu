#!name=GrandpaNiu Baidu Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/baidu.sgmodule

[Rule]
DOMAIN,afd.baidu.com,REJECT,pre-matching
DOMAIN,afdconf.baidu.com,REJECT,pre-matching
DOMAIN,mobads.baidu.com,REJECT,pre-matching
DOMAIN-SUFFIX,pos.baidu.com,REJECT,pre-matching

[URL Rewrite]
^https?:\/\/afd\.baidu\.com\/afd\/entry - reject-img
^https?:\/\/afd\.baidu\.com\/afd\/entry\?action=(update|query) - reject-dict
^https?:\/\/cover\.baidu\.com\/cover\/page\/dspSwitchAds\/ - reject
^https?:\/\/pan\.baidu\.com\/buy\/ad\/ - reject-200
^https?:\/\/pan\.baidu\.com\/rest\/\d\.\d\/pcs\/adv\? - reject-dict
^https?:\/\/update\.pan\.baidu\.com\/statistics - reject

[MITM]
hostname = %APPEND% afd.baidu.com,cover.baidu.com,pan.baidu.com,update.pan.baidu.com
