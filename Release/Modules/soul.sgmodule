#!name=GrandpaNiu Soul Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/soul.sgmodule

[Rule]
IP-CIDR,8.210.3.170/32,DIRECT
IP-CIDR,47.75.72.47/32,DIRECT
IP-CIDR,47.56.131.76/32,REJECT
IP-CIDR,47.97.215.55/32,REJECT
IP-CIDR,47.99.42.29/32,REJECT
IP-CIDR,47.110.187.87/32,REJECT
IP-CIDR,47.243.147.125/32,REJECT
IP-CIDR,120.27.235.201/32,REJECT
IP-CIDR,121.196.197.147/32,REJECT

[Body Rewrite]
http-response-jq ^https:\/\/(?:api-\w+|gateway-mobile-gray|post)\.soulapp\.cn\/(?:furion\/position\/content|hot\/soul\/rank|mobile\/app\/version\/queryIos|official\/scene\/module|teenager\/config|v2\/post\/gift\/list|v\d\/post\/homepage\/guide\/card) 'delpaths([["data"]])'

[Map Local]
^https:\/\/ssp\.soulapp\.cn\/api\/q data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/chat-live\.soulapp\.cn\/live\/planet\/recListV2 data-type=text data=" " status-code=200

[Script]
移除Soul广告 = type=http-response, pattern=^https:\/\/(?:api-\w+|chat-live|post)\.soulapp\.cn\/(?:chat\/limitInfo|chatroom\/chatClassifyRoomList|homepage\/diamond\/position\/info|v2\/post\/recSquare\/subTabs|v6\/planet\/config), script-path=https://kelee.one/Resource/JavaScript/Soul/Soul_remove_ads.js, requires-body=true

[MITM]
hostname = %APPEND% api*.soulapp.cn,gateway-mobile-gray.soulapp.cn,post.soulapp.cn,ssp.soulapp.cn
