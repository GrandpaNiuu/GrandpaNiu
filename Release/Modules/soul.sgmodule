#!name=GrandpaNiu Soul Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/soul.sgmodule

[Rule]
DOMAIN,ad-h5-cdn.soulapp.cn,REJECT,pre-matching
DOMAIN,ad-h5-station-cdn.soulapp.cn,REJECT,pre-matching
DOMAIN,ad-r.soulapp.cn,REJECT,pre-matching
DOMAIN,soul-ad.soulapp.cn,REJECT,pre-matching

[URL Rewrite]
^https?:\/\/chat-live\.soulapp\.cn\/live\/planet\/recListV\d - reject-200
^https?:\/\/ssp\.soulapp\.cn\/api\/q - reject-dict

[MITM]
hostname = %APPEND% chat-live.soulapp.cn,ssp.soulapp.cn
