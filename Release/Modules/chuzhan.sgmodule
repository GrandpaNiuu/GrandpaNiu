#!name=GrandpaNiu 触站 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/chuzhan.sgmodule

[URL Rewrite]
^https://app\.huashi6\.com/app/index/ad/ - reject-dict
^https://app\.huashi6\.com/app/works/relative$ - reject-dict
^https://app\.huashi6\.com/app/index/follow/all_random/list$ - reject-dict
^https://app\.huashi6\.com/app/index/csyxh/icon$ - reject-dict

[Body Rewrite]
http-response-jq ^https://app\.huashi6\.com/app/common/config$ '.data.disableAd = true data.showTopFloatAdvanceTips false'
http-response-jq ^https://app\.huashi6\.com/app/common/config$ 'del(.data.adsConfigIOS,.data.adsConfigAndroid,.data.url.tabMarket)'
http-response-jq ^https://app\.huashi6\.com/app/common/layouts$ '.data |= {CZ_MINE_MENUS: .CZ_MINE_MENUS}'
http-response-jq ^https://app\.huashi6\.com/app/common/themeConfig$ '.data.tabbars |= map(select(.title != "商城"))'

[MITM]
hostname = %APPEND% app.huashi6.com
