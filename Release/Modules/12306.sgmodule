#!name=GrandpaNiu 12306 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/12306.sgmodule

[Rule]
DOMAIN,ad.12306.cn,DIRECT

[Body Rewrite]
http-response-jq ^https://ad\.12306\.cn/ad/ser/getAdList$ 'del(.materialsList,.advertParam)'

[Script]
12306 = type=http-request,pattern=^https://mobile\.12306\.cn/otsmobile/app/mgs/mgw\.htm$,script-path=https://kelee.one/Resource/JavaScript/12306/12306_remove_ads.js

[MITM]
hostname = %APPEND% ad.12306.cn,mobile.12306.cn
