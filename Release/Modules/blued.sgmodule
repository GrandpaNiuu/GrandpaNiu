#!name=GrandpaNiu Blued Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/blued.sgmodule

[URL Rewrite]
^https?://social\.blued\.cn/users/recommend - reject-dict
^https?://social\.blued\.cn/users/no_auth/benefit - reject-dict

[Script]
blued.response.17 = type=http-response,pattern=^https?://social\.blued\.cn/users/.+/more/ios\?v=2,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/blued.js

[MITM]
hostname = %APPEND% social.blued.cn
