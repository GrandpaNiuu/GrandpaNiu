#!name=GrandpaNiu YouTube
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/youtube.sgmodule

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,youtubei.googleapis.com),(PROTOCOL,QUIC)),REJECT

[URL Rewrite]
^https?://[\w-]+\.googlevideo\.com/initplayback.+&oad - reject-200

[Script]
YouTube = type=http-response,pattern=^https://youtubei\.googleapis\.com/(youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch))(\?(.*))?$,requires-body=1,binary-body-mode=1,script-path=https://kelee.one/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_response.js

[MITM]
hostname = %APPEND% *.googlevideo.com,youtubei.googleapis.com
