#!name=GrandpaNiu YouTube
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/youtube.sgmodule

[Rule]
# YouTube safe passthrough start
DOMAIN-SUFFIX,youtube.com,PROXY,pre-matching
DOMAIN-SUFFIX,youtu.be,PROXY,pre-matching
DOMAIN-SUFFIX,ytimg.com,PROXY,pre-matching
DOMAIN-SUFFIX,ggpht.com,PROXY,pre-matching
DOMAIN-SUFFIX,googlevideo.com,PROXY,pre-matching
DOMAIN,youtubei.googleapis.com,PROXY,pre-matching
DOMAIN-SUFFIX,doubleclick.net,PROXY,pre-matching
DOMAIN-SUFFIX,googleadservices.com,PROXY,pre-matching
DOMAIN-SUFFIX,googlesyndication.com,PROXY,pre-matching
DOMAIN-SUFFIX,googletagservices.com,PROXY,pre-matching
# YouTube safe passthrough end
AND,((DOMAIN), (PROTOCOL,UDP)),REJECT-NO-DROP

[Map Local]

[Script]

[MITM]
hostname = %APPEND% 
