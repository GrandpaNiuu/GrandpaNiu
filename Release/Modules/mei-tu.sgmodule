#!name=GrandpaNiu 美图秀秀 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/mei-tu.sgmodule

[Rule]
DOMAIN,adui.tg.meitu.com,REJECT

[Body Rewrite]
http-response-jq ^https://api\.posters\.meitu\.com/common/init\.json 'del(.data.vip)'

[MITM]
hostname = %APPEND% api.posters.meitu.com
