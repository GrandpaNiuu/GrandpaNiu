[Script]
auto-home.response.1 = type=http-response,pattern=^https://news\.app\.autohome\.com\.cn/news_v\d+(?:\.\d+){2}/news/homenavigation,requires-body=1,script-path=https://kelee.one/Resource/JavaScript/AutoHome/AutoHome_remove_ads.js
