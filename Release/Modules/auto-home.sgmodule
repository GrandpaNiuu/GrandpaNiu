auto-home.response.11 = type=http-response,pattern=^https://(a\.athm\.cn/)?apiautoappusc\.che168\.com/apic/v\d+/gethomepagefeed,requires-body=1,script-path=https://kelee.one/Resource/JavaScript/AutoHome/AutoHome_remove_ads.js

