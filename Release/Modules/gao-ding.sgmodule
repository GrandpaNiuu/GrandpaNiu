#!name=GrandpaNiu 稿定设计 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/gao-ding.sgmodule

[URL Rewrite]
^https://www\.gaoding\.com/api/v\d/oc/v\d/delivery-pits/ios-splash/modules$ - reject-dict
^https://www\.gaoding\.com/api/v\d/oc/delivery-pits/(template|mine|home)-page-dialog/modules$ - reject-dict
^https://www\.gaoding\.com/api/v\d/cp/search-words/v2/placeholder - reject-dict

[Body Rewrite]
http-response-jq ^https://www\.gaoding\.com/api/v\d/oc/exhibitions/template/resources$ '.pits |= map(select(.module_type != "BANNER"))'
http-response-jq ^https://www\.gaoding\.com/api/v\d/oc/exhibitions/app_mine/resources$ '.pits |= map(select(.module_type != "BANNER"))'
http-response-jq ^https://www\.gaoding\.com/api/v\d/oc/exhibitions/(templates|all_editor_tools)/resources$ 'walk(if type == "object" and .badge_img_url? then .badge_img_url="" else . end)'

[MITM]
hostname = %APPEND% www.gaoding.com
