#!name=GrandpaNiu 得间小说 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/i-reader-dejian.sgmodule

[Rule]
DOMAIN,smad.ms.zhangyue.net,REJECT
DOMAIN,saad.ms.zhangyue.net,REJECT

[URL Rewrite]
^https://dj\.palmestore\.com/djad/ - reject-dict
^https://dj\.palmestore\.com/zybk/api/ad/ - reject-dict
^https://dj\.palmestore\.com/zyapi/bookstore/ad/ - reject-dict
^https://dj\.palmestore\.com/zybk/api/bookshelf/index\? - reject-dict

[Body Rewrite]
http-response-jq ^https://dj\.palmestore\.com/zybk/api/powerup/userGroup\? 'del(.body.sevenDaysAd,.body.shortPlayShow,.body.sdkShortPlayAB)'
http-response-jq ^https://dj\.palmestore\.com/zybk/api/search/index\? 'del(.body.keywords)'

[MITM]
hostname = %APPEND% dj.palmestore.com
