#!name=GrandpaNiu Spotify
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/spotify.sgmodule

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT

[URL Rewrite]
^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/pendragon/ - reject-dict
^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/artistview/v1/artist/(.*)&platform=iphone https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad header

[Script]
Protobuf = type=http-response,pattern=^https://(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?/(?:bootstrap|user-customization-service),requires-body=1,binary-body-mode=1,script-path=https://kelee.one/Resource/JavaScript/Spotify/Spotify_remove_ads.js,timeout=5

[MITM]
hostname = %APPEND% *-spclient.spotify.com,spclient.wg.spotify.com
