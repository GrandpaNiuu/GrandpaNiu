#!name=GrandpaNiu 测测 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/cece.sgmodule

[URL Rewrite]
^https://api\.cece\.com/user/index/banners\? - reject-dict
^https://api\.cece\.com/ask/ai_chat/popup\? - reject-dict
^https://api\.cece\.com/user/popup/ - reject-dict
^https://api\.cece\.com/chart/easter_egg/popup\? - reject-dict
^https://api\.cece\.com/user/register_task/notice_task\? - reject-dict
^https://api\.cece\.com/ask/ask/alert_minus\? - reject-dict
^https://api\.cece\.com/msgAsk/question/new_coupon_status\? - reject-dict
^https://api\.cece\.com/user/user/myPageBanner\? - reject-dict
^https://api\.cece\.com/live/recommend/new_user\? - reject-dict
^https://api\.cece\.com/chart/tools/get_search_recommend\? - reject-dict
^https://api\.cece\.com/user/rank/list\? - reject-dict
^https://api\.cece\.com/chart/config/chart_activity\? - reject-dict

[Body Rewrite]
http-response-jq ^https://api\.cece\.com/user/init\? 'del(.data.launch_img_url,.data.launch_goto_url)'
http-response-jq ^https://api\.cece\.com/common/app/app_config\? '.data.is_new_year = false data.spring_festival false data.show_feedback_entry false data.show_course_entry false data.show_store_entry false data.show_luna false data.show_ead false data.show_ad false data.show_live_filter_tarot false data.community_feed_adswitch false data.open_screen_ad_times 0 data.open_screen_ad_duration 0 data.isShowThumbsGif false data.teenager_mode_open false data.flu_log false'
http-response-jq ^https://api\.cece\.com/common/app/app_config\? 'del(.data.activity_list,.data.fortune_ab_config)'
http-response-jq ^https://api\.cece\.com/chart/tools/home_10_tools\? '.data.tools |= map(del(.icon_tip_image))'
http-response-jq ^https://api\.cece\.com/user/index/tab_list\? '.data.tabs |= map(select(.type != "shop"))'
http-response-jq ^https://api\.cece\.com/common/app/risk_entrance\? '.data.ai_fortune_show_ask_tool = false data.ai_sign_show_ask_tool false data.single_tool_show_dice_card false data.single_tool_show_tarot_card false data.single_tool_show_bazi_card false data.single_tool_show_hepan_card false data.single_tool_show_ziwei_card false data.single_tool_show_xingpan_card false data.multi_tool_show_card false data.ai_ccai_show_multi_tool false'

[Map Local]
^https://api\.cece\.com/live/user/coupon_tab\? data-type=json data="{"code":0,"msg":""}" status-code=200 status-code=200 header="content-type: application/json"

[MITM]
hostname = %APPEND% api.cece.com
