[Script]
flyer-tea.response.1 = type=http-response,pattern=^https://www\.flyert\.com\.cn/api/mobile/index\.php\?version=5,requires-body=1,script-path=https://kelee.one/Resource/JavaScript/FlyerTea/FlyerTea_remove_ads.js
