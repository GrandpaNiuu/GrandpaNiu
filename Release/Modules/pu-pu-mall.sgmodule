[URL Rewrite]
^https://j1\.pupuapi\.com/client/account/discount/order - reject
^https://j1\.pupuapi\.com/client/marketing/banner/v7\?position_types=100 - reject

[Script]
pu-pu-mall.response.1 = type=http-response,pattern=^https://j1\.pupuapi\.com/client/marketing/banner/v7,requires-body=1,script-path=https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js
pu-pu-mall.response.2 = type=http-response,pattern=^https://j1\.pupuapi\.com/client/marketing/banner/search_component_banner,requires-body=1,script-path=https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js
pu-pu-mall.response.3 = type=http-response,pattern=^https://j1\.pupuapi\.com/client/search/hot_keywords/v3,requires-body=1,script-path=https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js
pu-pu-mall.response.4 = type=http-response,pattern=^https://j1\.pupuapi\.com/client/app_resource/resource_preload/list_h5_resource,requires-body=1,script-path=https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js
pu-pu-mall.response.5 = type=http-response,pattern=^https://j1\.pupuapi\.com/client/recommendation/interests/products,requires-body=1,script-path=https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js
pu-pu-mall.response.6 = type=http-response,pattern=^https://j1\.pupuapi\.com/client/marketing/advertisement/v1,requires-body=1,script-path=https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js

