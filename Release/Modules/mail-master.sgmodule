#!name=GrandpaNiu 网易邮箱大师 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/mail-master.sgmodule

[URL Rewrite]
^https://appconf\.mail\.163\.com/mailmaster/api/http/urlConfig\.do$ - reject-dict
^https://dashi\.163\.com/task-center-api/fapi/task/list$ - reject-dict
^https://appconf\.mail\.163\.com/mailoperating/mailmaster/api/operator/get$ - reject-dict

[Body Rewrite]
http-response-jq ^https://appconf\.mail\.163\.com/mailmaster/api/page/v2/conf\.do$ 'del(.data.functionOperatorInfoList,.data.memberOperator,.data.activityTabInfoList)'
http-response-jq ^https://appconf\.mail\.163\.com/mailmaster/api/config/function\.do$ '.data.config[] |= if .result.tools then .result.tools |= map(select(.name == "邮件追踪" or .name == "替身邮箱")) else . end | del(.data.config[] | select(.functionName == "Function-AD"))'

[MITM]
hostname = %APPEND% appconf.mail.163.com,dashi.163.com
