#!name=GrandpaNiu 波点音乐 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/bodian-music.sgmodule

[URL Rewrite]
^https://bd-api\.kuwo\.cn/api/(play|service|advert)/advert/ - reject-dict
^https://bd-api\.kuwo\.cn/api/service/banner/ - reject-dict
^https://bd-api\.kuwo\.cn/api/ucenter/vip/give/config\? - reject-dict
^https://bd-api\.kuwo\.cn/api/service/home/module\?.*&moduleId=6 - reject-dict
^https://bd-api\.kuwo\.cn/api/pay/vip/lowPriceText\? - reject-dict
^https://bd-api\.kuwo\.cn/api/service/global/config/vipEnter\? - reject-dict
^https://bd-api\.kuwo\.cn/api/popup/ - reject-dict
^https://bd-api\.kuwo\.cn/api/pay/vip/invitation/swell/popup\? - reject-dict
^https://bd-api\.kuwo\.cn/api/service/version/popup\? - reject-dict
^https://bd-api\.kuwo\.cn/api/pay/vip/invitation/assist/popup\? - reject-dict
^https://bd-api\.kuwo\.cn/api/pay/h5/common/popup\? - reject-dict

[Body Rewrite]
http-response-jq ^https://bd-api\.kuwo\.cn/api/service/conf/all\? 'del(.data.groupSign.adStartAppDialog,.data.groupSign.adGuideTest,.data.groupSign.playTips,.data.groupSign.adExitChange,.data.conf.adGuidePopCount,.data.conf.adDownListOpen)'
http-response-jq ^https://bd-api\.kuwo\.cn/api/service/conf/all\? '.data.conf.flowControlConfig.uploadEnable = false data.conf.flowControlConfig.p2pEnable false'
http-response-jq ^https://ab-bodian\.kuwo\.cn/abtest/ui/info\? 'del(.data.mapTestInfo.CommentADPosition,.data.mapTestInfo.DiscoverADPosition,.data.mapTestInfo.DownloadAd,.data.mapTestInfo.FreeModVoiceReminder,.data.mapTestInfo.GamesTrans,.data.mapTestInfo.bodianmvdialog,.data.mapTestInfo.MvTryShowAds,.data.mapTestInfo.insert)'
http-response-jq ^https://bd-api\.kuwo\.cn/api/service/global/config/scene\? 'del(.data.iosP2PCacheEnable,.data.warmStartDialog,.data.adsNotFinishVipPop4DayInterval)'
http-response-jq ^https://bd-api\.kuwo\.cn/api/service/global/config/scene\? '.data.showShopEntry = false data.iosP2pEnableSendDataLimit 1'
http-response-jq ^https://bd-api\.kuwo\.cn/api/search/topic/word/list\? 'del(.data.hotTopic,.data.searchFind,.data.globalJumpInfo,.data.hotWord)'
http-response-jq ^https://bd-api\.kuwo\.cn/api/service/home/index\? '.data.moduleList |= map(select(.type | tostring | (. != "8" and . != "1")))'
http-response-jq ^https://bd-api\.kuwo\.cn/api/service/music/recommendList\? '.data.musicList[] |= del(.showAd)'
http-response-jq ^https://bd-api\.kuwo\.cn/api/comments/v3/topInfo\? 'del(.data.putao,.data.bannerVos)'

[MITM]
hostname = %APPEND% bd-api.kuwo.cn
