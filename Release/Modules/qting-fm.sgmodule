#!name=GrandpaNiu 蜻蜓FM Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/qting-fm.sgmodule

[Rule]
DOMAIN,ad.qtfm.cn,REJECT
DOMAIN,adlaunch.qtfm.cn,REJECT

[URL Rewrite]
^https://app\.qtfm\.cn/recommendapi/v8/ai_assistant_point$ - reject-dict
^https://app\.qtfm\.cn/m-bff/v1/signin/show_homepage_icon$ - reject-dict
^https://app\.qtfm\.cn/recommendapi/v\d/emotion$ - reject
^https://search\.qtfm\.cn/v\d/keyword/default$ - reject
^https://app\.qtfm\.cn/m-bff/v1/user/task/play$ - reject-dict
^https://app\.qtfm\.cn/m-bff/v\d/i_listen/guess_you_like\? - reject-dict
^https://recpage-c\.qtfm\.cn/v\d/favorites$ - reject-dict
^https://user\.qtfm\.cn/u\d/api/v\d/user/following_podcaster\? - reject-dict
^https://entry\.qtfm\.cn/api/v\d/personal/\?carrier - reject-dict
^https://search\.qtfm\.cn/v3/entry$ - reject-dict
^https://woqt2\.qtfm\.cn/v2/userConfig\? - reject-dict

[Body Rewrite]
http-response-jq ^https://app\.qtfm\.cn/m-bff/v\d/signin/show_homepage_icon$ '.data.display_icon = false'
http-response-jq ^https://app\.qtfm\.cn/recommendapi/v\d/hotpage\? '.data.head |= map(select(.type == "IconGrid")) | .data.feeds |= map(select(.type == "Channel" or .type == "Radio" or .type == "ListenListChannel"))'
http-response-jq ^https://app\.qtfm\.cn/m-bff/v\d/channel/\d{6}/playpage/\d{8} 'del(.data.related_recommend,.data.recommend_bar)'
http-response-jq ^https://app\.qtfm\.cn/m-bff/v\d/mylistenpage 'del(.data.banner)'
http-response-jq ^https://app\.qtfm\.cn/m-bff/v\d/subscribed_channels\? 'del(.data.recommends)'
http-response-jq ^https://app\.qtfm\.cn/m-bff/v1/channelpage/\d+$ 'del(.data.vip_recommend,.data.recommend_delivery)'

[MITM]
hostname = %APPEND% app.qtfm.cn,entry.qtfm.cn,recpage-c.qtfm.cn,user.qtfm.cn,search.qtfm.cn,woqt2.qtfm.cn
