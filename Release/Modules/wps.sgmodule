#!name=GrandpaNiu WPS Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/wps.sgmodule

[Rule]
DOMAIN,ad-stat.ksosoft.com,REJECT,pre-matching
DOMAIN,counter.ksosoft.com,REJECT,pre-matching
DOMAIN,minfo.wps.cn,REJECT,pre-matching
DOMAIN,img.auction-ads.wpscdn.cn,REJECT,pre-matching

[URL Rewrite]
^https?:\/\/ios\.wps\.cn\/ad-statistics-service - reject
^https?:\/\/ovs-shopwindow-server.*\.wps\.com\/api\/v\d\/shop_window\/type\/ios - reject-dict
^https?:\/\/tiance\.wps\.cn\/dce\/exec\/api\/market\/activity - reject-dict

[MITM]
hostname = %APPEND% ios.wps.cn,tiance.wps.cn,ovs-shopwindow-server*.wps.com
