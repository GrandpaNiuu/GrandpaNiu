#!name=GrandpaNiu 薄荷健康 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/boo-hee.sgmodule

[URL Rewrite]
^https://api\.boohee\.com/meta-interface/v1/index/page_float_bubbles\? - reject-dict
^https://api\.boohee\.com/meta-interface/v1/index/tool_buttons\? - reject-dict
^https://api\.boohee\.com/app-interface/v1/search/search\? - reject-dict
^https://status\.boohee\.com/api/v1/merged_messages$ - reject-dict
^https://bohe\.sfo-tx-shanghai-01\.saas\.sensorsdata\.cn/api/v2/sfo/user_popup_configs\? - reject-dict
^https://api\.boohee\.com/meta-interface/v1/index/sensor-banners\? - reject-dict

[Body Rewrite]
http-response-jq ^https://api\.boohee\.com/meta-interface/v2/index\? 'del(.data.recom_cards,.data.recom_btns)'
http-response-jq ^https://api\.boohee\.com/meta-interface/v1/index/plaza\? 'del(.data.tabs[1].badge,.data.recommend_ads)'
http-response-jq ^https://api\.boohee\.com/open-interface/v1/string/market_page\?title=metabolism_config$ 'del(.top_banner,.diagnos_config,.partner_hospital,.question_answer,.product,.brand_story)'

[Script]
boo-hee.response.1 = type=http-response,pattern=^https://api\.boohee\.com/meta-interface/v1/index/plaza-flow\?,requires-body=1,script-path=https://kelee.one/Resource/JavaScript/BooHee/BooHee_remove_ads.js

[MITM]
hostname = %APPEND% api.boohee.com,bohe.sfo-tx-shanghai-01.saas.sensorsdata.cn,lego.boohee.com,status.boohee.com
