#!name=GrandpaNiu Zhihu
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/zhihu.sgmodule

[Rule]
DOMAIN,appcloud.zhihu.com,REJECT,pre-matching
DOMAIN,appcloud2.in.zhihu.com,REJECT,pre-matching
DOMAIN,crash2.zhihu.com,REJECT,pre-matching
DOMAIN,mqtt.zhihu.com,REJECT,pre-matching
DOMAIN,sugar.zhihu.com,REJECT,pre-matching

[URL Rewrite]
^https?:\/\/api\.zhihu\.com\/(?:bazaar\/float_window|market\/popovers_v2) - reject-dict
^https?:\/\/api\.zhihu\.com\/(?:moments\/lastread|drama\/hot-drama-list) - reject-dict
^https?:\/\/api\.zhihu\.com\/ab\/api\/v1\/products\/zhihu\/platforms\/ios\/config - reject-dict
^https?:\/\/api\.zhihu\.com\/ad-style-service\/request - reject-dict
^https?:\/\/api\.zhihu\.com\/comment_v5\/(?:articles|answers)\/\d+\/list-headers - reject-dict
^https?:\/\/api\.zhihu\.com\/commercial_api\/ - reject-dict
^https?:\/\/api\.zhihu\.com\/content-distribution-core\/bubble\/common\/settings - reject-dict
^https?:\/\/api\.zhihu\.com\/distribute\/rhea\/qa_ad_card\/h5\/recommendation\? - reject-dict
^https?:\/\/api\.zhihu\.com\/me\/guides - reject-dict
^https?:\/\/api\.zhihu\.com\/people\/homepage_entry_v2 - reject-dict
^https?:\/\/api\.zhihu\.com\/prague\/related_suggestion_native\/feed\? - reject-dict
^https?:\/\/api\.zhihu\.com\/root\/window - reject-dict
^https?:\/\/api\.zhihu\.com\/search\/(hot_search|preset_words) - reject-dict
^https?:\/\/api\.zhihu\.com\/unlimited\/go\/my_card - reject
^https?:\/\/api\.zhihu\.com\/v5\.1\/topics\/answer\/\d+\/relation - reject-dict
^https?:\/\/appcloud2\.zhihu\.com\/v3\/resource\?group_name=mp - reject-dict
^https?:\/\/link\.zhihu\.com\/\?target=(?:https?)?(?:%3A|:)?(?:\/\/|%2F%2F)?(.*) http://$1 302
^https?:\/\/www\.zhihu\.com\/api\/v4/(?:answers|questions)\/\d+/related-readings - reject-dict
^https?:\/\/www\.zhihu\.com\/api\/v4\/hot_recommendation - reject-dict
^https?:\/\/www\.zhihu\.com\/api\/v4\/mcn\/v2\/linkcards\? - reject-dict
^https?:\/\/www\.zhihu\.com\/api\/v4\/search\/related_queries\/(?:article|answer)\/\d+ - reject-dict
^https?:\/\/www\.zhihu\.com\/appview\/v3\/zhmore - reject
^https?:\/\/www\.zhihu\.com\/commercial_api\/banners_v3\/mobile_banner - reject-dict
^https?:\/\/zhuanlan\.zhihu\.com\/api\/articles\/\d+\/recommendation - reject-dict

[Body Rewrite]
http-response ^https?:\/\/api\.zhihu\.com\/search\/recommend_query\/v2\? "recommend_queries":\{.+\} "recommend_queries":{}
http-response-jq ^https?:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/header\? 'delpaths([["activity_banner"]])'
http-response-jq ^https?:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/header\? 'delpaths([["activity_window"]])'
http-response-jq ^https?:\/\/api\.zhihu\.com\/bazaar\/vip_tab\/header\? 'delpaths([["vip_tip"]])'
http-response-jq ^https?:\/\/api\.zhihu\.com\/questions\/\d+(?:\/answers|\/feeds|\?include=) 'del(.ad_info, .data.ad_info?, .query_info) | if (.data | type) == "array" then .data |= map(select(.target.answer_type | if . == null then "" else tostring end | contains("paid") | not)) else . end'
http-response-jq ^https?:\/\/oneapp-api\.faw-vw\.com\/content\/booth\/getBoothList\/v1\?.*showPositionCode=VWAPP_(?:ICE|MEB)_(?:OPEN_SCREEN_ADS|CAR_ZHIHU_COLLEGE) '. = { returnStatus: "SUCCEED", hasMore: false, data: [] }'
http-response-jq ^https?:\/\/api\.zhihu\.com\/search\/recommend_query\/v2\? 'del(.recommend_queries)'

[Script]
cmp_allad_019_zhihu = type=http-response,pattern=^https?:\/\/api\.zhihu\.com\/(v\d\/)?questions\/\d+\/(feeds|answers)\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/zhihu.js,script-update-interval=86400
zhihu-enhance = type=http-response,pattern=^https?:\/\/api\.zhihu\.com\/(topstory|moments|feed|notifications|v\d+\/questions\/\d+\/(feeds|answers)|questions\/\d+\/(feeds|answers)|search\/top_search|search\/recommend_query|commercial|market|ad|recommend).*?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/GrandpaNiuu/GrandpaNiu/main/Scripts/zhihu-enhance.js,script-update-interval=86400

[MITM]
hostname = %APPEND% api.zhihu.com,appcloud2.zhihu.com,link.zhihu.com,m-cloud.zhihu.com,page-info.zhihu.com,www.zhihu.com,zhuanlan.zhihu.com
