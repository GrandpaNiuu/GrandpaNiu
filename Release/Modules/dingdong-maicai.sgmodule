#!name=GrandpaNiu 叮咚买菜 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/dingdong-maicai.sgmodule

[Rule]
DOMAIN,trackercollect.ddxq.mobi,REJECT
DOMAIN,ddfs-public.ddimg.mobi,REJECT
DOMAIN,rttrack.ddxq.mobi,REJECT

[URL Rewrite]
^https?://119\.29\.29\.\d+/d - reject-200
^https?://maicai\.api\.ddxq\.mobi/advert/ - reject
^https?://maicai\.api\.ddxq\.mobi/homeApi/getHomeAdPop - reject
^https://maicai\.api\.ddxq\.mobi/vip/getVipAd/\? - reject-dict
^https://maicai\.api\.ddxq\.mobi/homeApi/marketingNotice\? - reject-dict
^https://maicai\.api\.ddxq\.mobi/search/rollHotKeyword\? - reject-dict
^https://maicai\.api\.ddxq\.mobi/search/rankingList\? - reject-dict
^https://maicai\.api\.ddxq\.mobi/search/hotKeyword\? - reject-dict
^https://maicai\.api\.ddxq\.mobi/order/getRecommend$ - reject-dict
^https://maicai\.api\.ddxq\.mobi/homeApi/userLike\? - reject-dict
^https://user\.api\.ddxq\.mobi/userportal-service/api/v1/user/queryMyPage/\? - reject-dict
^https://maicai\.api\.ddxq\.mobi/guide-service/userLike/flowData$ - reject-dict

[Body Rewrite]
http-response-jq ^https://maicai\.api\.ddxq\.mobi/homeApi/categoriesNewDetail\? 'del(.data.ad_info)'
http-response-jq ^https://maicai\.api\.ddxq\.mobi/tool/getConfig\? 'del(.data.ai_enter_config)'
http-response-jq ^https?://maicai\.api\.ddxq\.mobi/homeApi/newDetails\? 'del(.data.top_advert_data,.data.suspension)'
http-response-jq ^https?://maicai\.api\.ddxq\.mobi/homeApi/newDetails\? '.data.list |= map(select(has("capsule_freedom_zone") | not))'
http-response-jq ^https://maicai\.api\.ddxq\.mobi/guide-service/productApi/productDetail/info\? 'del(.data.detail.chatEntry)'
http-response-jq ^https?://maicai\.api\.ddxq\.mobi/homeApi/bottomNavi 'del(.data.adId?) | if (.data.bottom_list? | length > 0) then .data.bottom_list |= map(select(.type != "eatwhat")) else . end'
http-response-jq ^https?://maicai\.api\.ddxq\.mobi/homeApi/homeFlowDetail 'walk(if type == "object" and has("list") then .list |= map(if type == "object" and has("multi_advertise_data_list") then del(.multi_advertise_data_list) else . end) else . end)'

[MITM]
hostname = %APPEND% 119.29.29.*,maicai.api.ddxq.mobi,user.api.ddxq.mobi
