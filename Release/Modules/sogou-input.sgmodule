^https?://h5api\.sginput\.qq\.com/v1/gcenter/ios/homepage - reject-dict

[MITM]
hostname = %APPEND% business-cdn.shouji.sogou.com,ios.sogou.com,android.sogou.com,h5api.sginput.qq.com
