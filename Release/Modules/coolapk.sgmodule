[Script]
coolapk.response.15 = type=http-response,pattern=^https?://api\.coolapk\.com/v6/feed/(detail|replyList)\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/coolapk.js
coolapk.response.16 = type=http-response,pattern=^https?://api\.coolapk\.com/v6/main/(dataList|indexV8|init),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/coolapk.js
coolapk.response.17 = type=http-response,pattern=^https?://api\.coolapk\.com/v6/page/dataList\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/coolapk.js

