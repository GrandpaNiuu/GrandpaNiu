#!name=GrandpaNiu 车来了 Source
#!desc=Generated per-app module from GrandpaNiu app source or fusion output
#!update-url=https://grandpaniuu.github.io/GrandpaNiu/Release/Modules/che-lai-le.sgmodule

[Rule]
DOMAIN-SUFFIX,atrace.chelaile.net.cn,REJECT
DOMAIN,logs.chelaile.net.cn,REJECT
DOMAIN,ad.chelaile.net.cn,REJECT

[URL Rewrite]
^https?://pic1\.chelaile\.net\.cn/adv/ - reject
^https?://(api|atrace)\.chelaile\.net\.cn/adpub/ - reject
^https?://api\.chelaile\.net\.cn/goocity/advert/ - reject
^https?://atrace\.chelaile\.net\.cn/adpub/ - reject-img
^https?://atrace\.chelaile\.net\.cn/exhibit\?&adv_image - reject-img
^https?://web\.chelaile\.net\.cn/api/adpub/ad - reject
^https?://cdn\.\w{3}\.chelaileapp\.cn/(api/)?adpub - reject

[MITM]
hostname = %APPEND% pic1.chelaile.net.cn,api.chelaile.net.cn,atrace.chelaile.net.cn,web.chelaile.net.cn,cdn.*.chelaileapp.cn
